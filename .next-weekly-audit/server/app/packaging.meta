{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/packaging/layout,_N_T_/packaging/page,_N_T_/packaging"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/packaging/__PAGE__",
    "/packaging",
    "/_index",
    "/_head"
  ]
}