{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/packaging/layout,_N_T_/packaging/logs/layout,_N_T_/packaging/logs/page,_N_T_/packaging/logs"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/packaging/logs/__PAGE__",
    "/packaging/logs",
    "/packaging",
    "/_index",
    "/_head"
  ]
}