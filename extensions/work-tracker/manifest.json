{
  "manifest_version": 3,
  "name": "KhyatiGems Work Tracker",
  "version": "1.0.0",
  "minimum_chrome_version": "120",
  "description": "Opt-in active-tab work estimates for KhyatiGems ERP and supported marketplaces.",
  "permissions": [
    "storage",
    "tabs",
    "idle",
    "alarms"
  ],
  "host_permissions": [
    "https://erp.khyatigems.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "src/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Work Tracker \u2014 paused"
  },
  "options_page": "src/options.html"
}
